#!/bin/bash
# bm - terminal bookmark manager on top of keepassxc-cli and a KeePass .kdbx file.
set -euo pipefail

# Optional settings file with BM_* lines; exported so bm-touchid sees them too.
CONFIG="${BM_CONFIG:-$HOME/.config/bm/config}"
if [[ -f "$CONFIG" ]]; then set -a; source "$CONFIG"; set +a; fi

BM_VERSION="1.1"
DB="${BM_DB:-$HOME/.config/bm/bookmarks.kdbx}"
CLIP_TIMEOUT="${BM_CLIP_TIMEOUT:-20}"
KC_SERVICE="bm"
HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
TOUCHID="$HERE/bm-touchid"
KXC="$(command -v keepassxc-cli || echo /Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli)"

KEY_ARGS=()
[[ -n "${BM_KEYFILE:-}" ]] && KEY_ARGS=(-k "$BM_KEYFILE")

die() { echo "bm: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: bm <command> [args]

  init                          create a new database
  add <url> [-t title] [-g group] [-u user] [-p] [-k keyfile]
                                add a bookmark (-p asks for a password,
                                -k attaches an SSH private key)
  ls [group]                    list entries
  find <query>                  search entries
  open <query>                  open the URL in the default browser
  url <query>                   print the URL
  show [-s] <query>             show the entry fields and attachments (password hidden);
                                -s asks, then shows the password and copies it
  pass <query>                  copy the password to the clipboard
  user <query>                  copy the username to the clipboard
  ssh <query> [ssh args]        connect with the entry's key or password
  ssh -d <[user@]host[:port]>   connect to any server with the "default" entry
  telnet <query>                connect and log in with the entry's password
  telnet -d <host[:port]>       same, with the "default" entry
  plink <query> [plink args]    PuTTY plink over ssh, for old devices with legacy ciphers
  plink -d <[user@]host[:port]> same, with the "default" entry
  edit <query> [-t title] [-u user] [--url url] [-p]
                                change an entry
  rm <query>                    move an entry to the recycle bin
  keychain on|off               store or forget the master password in Keychain (Touch ID)
  lock                          forget the Touch ID approval now
  version                       print the version

Settings (environment or ~/.config/bm/config):
  BM_DB, BM_KEYFILE, BM_CLIP_TIMEOUT, BM_KEY_TTL,
  BM_TOUCHID_TTL   seconds one Touch ID stays valid, 0 = ask every time (default 3600)
  BM_TOUCHID_LOCK  0 = keep the approval when the screen locks (default 1)
EOF
}

# Master password: Keychain behind Touch ID if enabled, otherwise prompt.
MP=""
master() {
  [[ -n "$MP" ]] && return
  if security find-generic-password -s "$KC_SERVICE" -a "$DB" >/dev/null 2>&1; then
    [[ -x "$TOUCHID" ]] || die "bm-touchid not built, run 'make' in $HERE"
    # Only bm-touchid can read the item; it prints the password after Touch ID.
    MP="$("$TOUCHID" get "$KC_SERVICE" "$DB" "unlock bookmarks")" || die "Touch ID failed"
  else
    read -rsp "Master password: " MP; echo >&2
  fi
}

# Run keepassxc-cli with the master password (and optional extra stdin lines) on stdin.
kx() {
  local cmd="$1"; shift
  master
  printf '%s\n' "$MP" "${EXTRA[@]+"${EXTRA[@]}"}" | "$KXC" "$cmd" -q "${KEY_ARGS[@]+"${KEY_ARGS[@]}"}" "$DB" "$@"
}
EXTRA=()

# Resolve a query to exactly one entry path; ask the user when several match.
resolve() {
  local q="$1" matches n i
  matches="$(kx search "$q" 2>/dev/null)" || die "nothing found: $q"
  n="$(printf '%s\n' "$matches" | wc -l | tr -d ' ')"
  if [[ "$n" == 1 ]]; then echo "$matches"; return; fi
  printf '%s\n' "$matches" | nl -w2 -s') ' >&2
  read -rp "Choose [1-$n]: " i
  [[ "$i" =~ ^[0-9]+$ ]] && (( i >= 1 && i <= n )) || die "bad choice"
  printf '%s\n' "$matches" | sed -n "${i}p"
}

ask_pass() {
  local p1 p2
  read -rsp "Entry password: " p1; echo >&2
  read -rsp "Repeat: " p2; echo >&2
  [[ "$p1" == "$p2" ]] || die "passwords do not match"
  EXTRA=("$p1")
}

# Connect over ssh or telnet with the entry's username plus key or password.
# URL forms: ssh://user@host:port, telnet://host:port, host.
remote() {
  local proto="$1" e="" url="" user="" pw="" t host port
  if [[ -z "$TARGET" ]]; then
    e="$(resolve "$2")"
  elif kx show -a title default >/dev/null 2>&1; then
    e=default
  elif (( EXPLICIT_D )); then
    die "no entry 'default', create it: bm add ssh://default -t default -u <user> [-p] [-k keyfile]"
  else
    echo "no 'default' entry, connecting without saved credentials" >&2
  fi
  shift 2
  [[ -n "$e" ]] && { IFS= read -r url; IFS= read -r user; IFS= read -r pw; } \
    < <(kx show -s -a url -a username -a password "$e")
  t="${TARGET:-${url:-${e##*/}}}"; t="${t#*://}"; t="${t%%/*}"
  if [[ "$t" == *@* ]]; then
    # For an entry its username field wins; for a server typed by hand, user@ wins.
    [[ -n "$TARGET" || -z "$user" ]] && user="${t%%@*}"
    t="${t#*@}"
  fi
  host="${t%%:*}"; port=""; [[ "$t" == *:* ]] && port="${t##*:}"
  [[ -n "$host" ]] || die "no host in $e"

  if [[ "$proto" == ssh || "$proto" == plink ]]; then
    # ponytail: key goes to ssh-agent for KEY_TTL seconds, never to disk.
    if [[ -n "$e" ]] && kx attachment-export --stdout "$e" ssh-key 2>/dev/null | ssh-add -q -t "${BM_KEY_TTL:-600}" - 2>/dev/null; then
      echo "key from $e loaded into ssh-agent for ${BM_KEY_TTL:-600}s" >&2
    fi
    if [[ "$proto" == plink ]]; then
      # plink takes keys from ssh-agent (SSH_AUTH_SOCK), then the password from a pipe,
      # so the password is not in argv and not on disk.
      local args=(-ssh -agent)
      [[ -n "$port" ]] && args+=(-P "$port")
      [[ -n "$user" ]] && args+=(-l "$user")
      [[ -n "$pw" ]] && args+=(-pwfile <(printf '%s\n' "$pw"))
      exec plink "${args[@]}" "$host" "$@"
    fi
    # ssh tries keys first (agent, ~/.ssh), then the password.
    if [[ -n "$pw" ]]; then
      # ssh asks bm itself for the password; exported env does not show in argv.
      export SSH_ASKPASS="$HERE/bm" SSH_ASKPASS_REQUIRE=force BM_ASKPASS_PW="$pw"
    fi
    exec ssh ${port:+-p "$port"} ${user:+-l "$user"} "$host" "$@"
  fi

  [[ -n "$pw" ]] || exec telnet "$host" ${port:+"$port"}
  export BM_HOST="$host" BM_PORT="$port" BM_USER="$user" BM_PW="$pw"
  exec expect -c '
    set user $env(BM_USER); set pw $env(BM_PW)
    unset env(BM_PW) env(BM_USER)
    set timeout 20
    if {$env(BM_PORT) eq ""} { spawn telnet $env(BM_HOST) } else { spawn telnet $env(BM_HOST) $env(BM_PORT) }
    expect {
      -nocase -re {(login|user ?name)[^:\n]*: *$} { if {$user ne ""} { send -- "$user\r" }; exp_continue }
      -nocase -re {password[^:\n]*: *$} { send -- "$pw\r" }
      timeout {}
      eof { exit 1 }
    }
    interact'
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift

# SSH_ASKPASS mode: answer password prompts, ask the user for anything else (host key etc).
if [[ -n "${BM_ASKPASS_PW:-}" ]]; then
  case "$cmd" in
    *assword*|*assphrase*) printf '%s\n' "$BM_ASKPASS_PW" ;;
    *) printf '%s ' "$cmd" >/dev/tty; read -r a </dev/tty; echo "$a" ;;
  esac
  exit 0
fi

[[ "$cmd" == init || "$cmd" == keychain || "$cmd" == lock || "$cmd" == version || "$cmd" == -V || "$cmd" == --version || -z "$cmd" || "$cmd" == -h || "$cmd" == help ]] \
  || { [[ -f "$DB" ]] || die "no database at $DB, run 'bm init'"
       # Unlock once here: resolve() runs in a subshell and cannot keep MP.
       master; }

case "$cmd" in
  init)
    [[ -f "$DB" ]] && die "database already exists: $DB"
    mkdir -p "$(dirname "$DB")"
    "$KXC" db-create -p "${KEY_ARGS[@]+"${KEY_ARGS[@]}"}" "$DB"
    ;;
  add)
    url="${1:-}"; [[ -n "$url" ]] || die "add: URL required"; shift
    title="" group="" user="" withpass=0 key=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -t) title="$2"; shift 2 ;;
        -g) group="$2"; shift 2 ;;
        -u) user="$2"; shift 2 ;;
        -p) withpass=1; shift ;;
        -k) key="$2"; [[ -f "$key" ]] || die "add: no key file $key"; shift 2 ;;
        *) die "add: unknown option $1" ;;
      esac
    done
    [[ -n "$title" ]] || { title="${url#*://}"; title="${title%%/*}"; title="${title#*@}"; }
    # Keep user@ from the URL in the username field, so show and edit see it.
    if [[ -z "$user" ]]; then t="${url#*://}"; t="${t%%/*}"; [[ "$t" == *@* ]] && user="${t%%@*}"; fi
    path="$title"
    if [[ -n "$group" ]]; then
      # Create every level of the group; existing groups make mkdir fail, which is fine.
      g=""
      IFS=/ read -ra parts <<<"$group"
      for part in "${parts[@]}"; do g="${g:+$g/}$part"; kx mkdir "$g" >/dev/null 2>&1 || true; done
      path="$group/$title"
    fi
    args=(--url "$url")
    [[ -n "$user" ]] && args+=(-u "$user")
    (( withpass )) && { ask_pass; args+=(-p); }
    kx add "${args[@]}" "$path"
    EXTRA=()
    [[ -n "$key" ]] && kx attachment-import "$path" ssh-key "$key" >/dev/null
    echo "added: $path"
    ;;
  ssh|telnet|plink)
    # -d <server>: any server, credentials from the root entry "default".
    # No entry matches the query: treat the query as a server, the same as -d.
    TARGET="" EXPLICIT_D=0
    if [[ "${1:-}" == -d ]]; then
      TARGET="${2:-}"; EXPLICIT_D=1; [[ -n "$TARGET" ]] || die "$cmd -d: server required"; shift
    fi
    [[ -n "${1:-}" ]] || die "$cmd: query required"
    if [[ -z "$TARGET" ]] && ! kx search "$1" >/dev/null 2>&1; then
      TARGET="$1"; echo "no entry for $1, using 'default'" >&2
    fi
    remote "$cmd" "$@"
    ;;
  ls)
    kx ls -R -f ${1:+"$1"} | grep -v '/$'
    ;;
  find)
    [[ -n "${1:-}" ]] || die "find: query required"
    kx search "$1"
    ;;
  open|url)
    [[ -n "${1:-}" ]] || die "$cmd: query required"
    e="$(resolve "$1")"
    u="$(kx show -a url "$e")"
    [[ -n "$u" ]] || die "no URL in $e"
    if [[ "$cmd" == open ]]; then open "$u"; else echo "$u"; fi
    ;;
  show)
    secret=0; [[ "${1:-}" == -s ]] && { secret=1; shift; }
    [[ -n "${1:-}" ]] || die "show: query required"
    e="$(resolve "$1")"
    if (( secret )); then
      echo "WARNING: the password of $e will be shown in clear text." >&2
      echo "It stays in the terminal scrollback and can be seen on your screen." >&2
      read -rp "Show it? [y/N] " a
      [[ "$a" == y || "$a" == Y ]] || exit 0
    fi
    echo "Path: $e"
    # Without -s keepassxc-cli prints the password as PROTECTED.
    if (( secret )); then kx show --show-attachments -s "$e"; else kx show --show-attachments "$e"; fi
    if (( secret )); then
      kx clip "$e" "$CLIP_TIMEOUT" >/dev/null 2>&1 &
      disown
      echo "password copied, clears in ${CLIP_TIMEOUT}s" >&2
    fi
    ;;
  pass|user)
    [[ -n "${1:-}" ]] || die "$cmd: query required"
    e="$(resolve "$1")"
    attr=password; [[ "$cmd" == user ]] && attr=username
    # clip blocks until it clears the clipboard, so run it in the background.
    kx clip -a "$attr" "$e" "$CLIP_TIMEOUT" >/dev/null 2>&1 &
    disown
    echo "$attr of $e copied, clears in ${CLIP_TIMEOUT}s"
    ;;
  edit)
    [[ -n "${1:-}" ]] || die "edit: query required"
    e="$(resolve "$1")"; shift
    args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -t) args+=(-t "$2"); shift 2 ;;
        -u) args+=(-u "$2"); shift 2 ;;
        --url) args+=(--url "$2"); shift 2 ;;
        -p) ask_pass; args+=(-p); shift ;;
        *) die "edit: unknown option $1" ;;
      esac
    done
    [[ ${#args[@]} -gt 0 ]] || die "edit: nothing to change"
    kx edit "${args[@]}" "$e" && echo "changed: $e"
    ;;
  rm)
    [[ -n "${1:-}" ]] || die "rm: query required"
    e="$(resolve "$1")"
    read -rp "Move $e to the recycle bin? [y/N] " a
    [[ "$a" == y || "$a" == Y ]] || exit 0
    kx rm "$e"
    ;;
  keychain)
    case "${1:-}" in
      on)
        [[ -x "$TOUCHID" ]] || die "bm-touchid not built, run 'make' in $HERE"
        cat >&2 <<'EOF'
WARNING: use this only on a trusted Mac.
Only bm-touchid can read the stored master password, after Touch ID.
But while one Touch ID approval is cached (BM_TOUCHID_TTL, default 1 hour),
any program that runs as your user can run bm without Touch ID.
On an untrusted Mac set BM_TOUCHID_TTL=0 or do not use Keychain.
EOF
        read -rp "Store the master password in Keychain? [y/N] " a
        [[ "$a" == y || "$a" == Y ]] || exit 0
        read -rsp "Master password: " MP; echo >&2
        # Check the password before storing it.
        kx ls >/dev/null || die "wrong master password"
        # Drop an old item made by `security` (it trusts `security`), then let the
        # helper create a new one that trusts only the helper.
        security delete-generic-password -s "$KC_SERVICE" -a "$DB" >/dev/null 2>&1 || true
        printf '%s\n' "$MP" | "$TOUCHID" set "$KC_SERVICE" "$DB" || die "cannot store in Keychain"
        echo "master password stored in Keychain, only bm-touchid can read it after Touch ID"
        ;;
      off)
        [[ -x "$TOUCHID" ]] && "$TOUCHID" --forget
        security delete-generic-password -s "$KC_SERVICE" -a "$DB" >/dev/null && echo "removed from Keychain"
        ;;
      *) die "keychain: on or off" ;;
    esac
    ;;
  lock)
    [[ -x "$TOUCHID" ]] && "$TOUCHID" --forget
    echo "Touch ID approval forgotten"
    ;;
  -V|--version|version) echo "bm $BM_VERSION" ;;
  ""|-h|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
